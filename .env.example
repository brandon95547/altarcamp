# Copy to .env for docker compose, or to apps/api/.env to run the API directly.

# --- database ---------------------------------------------------------------
POSTGRES_USER=altar
POSTGRES_PASSWORD=altar_dev_password
POSTGRES_DB=altar
POSTGRES_PORT=5442

# When running the API outside Docker against the compose database:
DATABASE_URL=postgres://altar:altar_dev_password@localhost:5442/altar

# --- api --------------------------------------------------------------------
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
# At least 32 characters. Generate one: openssl rand -base64 48
SESSION_SECRET=dev-only-session-secret-change-me-32-chars
SESSION_TTL_HOURS=24
# true once the site is served over HTTPS
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:5190
PUBLIC_WEB_URL=http://localhost:5190
STORAGE_DRIVER=local
STORAGE_DIR=./storage

# Seed a demo artist mid-flow so the product can be walked through. Set false for a real deployment.
SEED_DEMO=true

# Seeded on first boot so there is always a way in. Change the password immediately.
ADMIN_EMAIL=admin@altar.camp
ADMIN_PASSWORD=AltarCampAdmin!2026

# --- mail -------------------------------------------------------------------
# log: write each email (the signup welcome) to the API log instead of sending it.
# smtp: send it. SMTP_HOST, SMTP_USER and SMTP_PASS are then required, or the API refuses to boot.
MAIL_DRIVER=log
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# The sending address. Leave empty to use SMTP_USER, which is what most providers require.
MAIL_FROM=
MAIL_FROM_NAME=Altar.Camp
MAIL_REPLY_TO=support@altar.camp

# --- web --------------------------------------------------------------------
API_PORT=4000
WEB_PORT=5190
