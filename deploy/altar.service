# /etc/systemd/system/altar.service — Altar.Camp (Docker, 127.0.0.1:5190)
#
# Install:  cp deploy/altar.service /etc/systemd/system/ && systemctl daemon-reload
#           systemctl enable --now altar
# Deploy:   rsync the tree to /var/www/altar, then `systemctl restart altar`
#           (this repo has no git remote, so there is nothing to pull on the server)
#
# Runs `docker compose up` in the FOREGROUND rather than detached, so systemd owns the
# stack: it restarts it if a container dies and the output lands in the journal. Same
# shape as shotmatrix.service, which is the other compose-under-systemd service here.
#
# Three containers: web (nginx image, serves the built SPA), api (Node) and db (Postgres
# 17). The db is the app's OWN — it does not share phansora_postgres, because this is a
# separate product with its own migrations and its own backup story.
#
# EVERY PORT IS BOUND TO 127.0.0.1 by the .env, not to 0.0.0.0. Compose's default publishes
# on every interface, which on a public box would put the API and an unauthenticated
# Postgres straight onto the internet. nginx is the only way in.
[Unit]
Description=Altar.Camp — artist signing platform (Docker, 127.0.0.1:5190)
After=docker.service network-online.target
Requires=docker.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/var/www/altar
# Rebuilt on every start. Unchanged layers are cached, so a restart is seconds; the long
# timeout is for the first build, which installs the workspace and builds the SPA.
ExecStartPre=/usr/bin/docker compose build
ExecStart=/usr/bin/docker compose up --no-log-prefix --abort-on-container-exit
ExecStop=/usr/bin/docker compose down
Restart=always
RestartSec=10
TimeoutStartSec=900

[Install]
WantedBy=multi-user.target
