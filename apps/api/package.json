{
  "name": "@altar/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx --watch-path=./src src/index.ts",
    "build": "tsc -p tsconfig.json && cp -R src/db/migrations dist/db/migrations",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "db:migrate": "node --env-file-if-exists=.env --import tsx src/db/cli.ts migrate",
    "db:seed": "node --env-file-if-exists=.env --import tsx src/db/cli.ts seed",
    "db:reset": "node --env-file-if-exists=.env --import tsx src/db/cli.ts reset",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@altar/shared": "*",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.1.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/swagger": "^9.5.2",
    "@scalar/fastify-api-reference": "^1.38.6",
    "fastify": "^5.12.3",
    "fastify-plugin": "^5.1.0",
    "fastify-type-provider-zod": "^7.0.0",
    "nodemailer": "^10.0.10",
    "pg": "^8.16.3",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/pg": "^8.15.6",
    "pino-pretty": "^13.1.2",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3",
    "vitest": "^5.0.1"
  }
}
